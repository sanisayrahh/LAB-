#excel sheet + cross validation
#Training
#1.Load the data(our own data)
import pandas as pd
file=pd.read_csv("/irisexcel.csv")

x=file[["sepal_length","sepal_width","petal_length","petal_width"]]
y=file["species"]

#cross validation
from sklearn.model_selection import train_test_split
x_train,x_test,y_train,y_test=train_test_split(x,y,test_size=0.2)

#2.Load the model
from sklearn.linear_model import Perceptron
model=Perceptron()
#3.Fit the data into the model
model.fit(x_train,y_train)

#validation
from sklearn.metrics import accuracy_score
op_validation=model.predict(x_test)
score=accuracy_score(y_test,op_validation)
print(score*100)

#Testing
df=pd.DataFrame([[1,1,1,1]],columns=x.columns)
op_test=model.predict(df)
print(op_test)
