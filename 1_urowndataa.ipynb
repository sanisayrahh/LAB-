        "#load data\n",
        "x=[[100],[80],[50]]\n",
        "y=[\"A\",\"B\",\"C\"]\n",
        "#load model\n",
        "from sklearn.linear_model import Perceptron\n",
        "m=Perceptron()\n",
        "#load data into model\n",
        "m.fit(x,y)\n",
        "#testing\n",
        "op=m.predict([[55]])\n",
        "print(op)\n"
